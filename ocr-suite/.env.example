# Copy to .env and fill in. Read by docker-compose.yml.
# A backend left empty shows as "unconfigured" in the UI instead of erroring,
# so a typo here looks like the model simply isn't deployed — check for that
# first if a model is missing from the dropdown.

PADDLEOCR_VL_GGUF_BASE_URL=https://
PADDLEOCR_VL_BASE_URL=https://
UNLIMITED_OCR_BASE_URL=https://

# Optional
JPEG_QUALITY=92
JPEG_ABOVE_KB=400
PANE_MAX_HEIGHT=68vh
