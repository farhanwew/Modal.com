# Copy to .env and fill in. Read by the Docker client.
# A backend left empty shows as "unconfigured" in the UI instead of erroring,
# so a typo here looks like the model simply isn't deployed — check for that
# first if a model is missing from the dropdown.

PADDLEOCR_VL_GGUF_BASE_URL=https://
PADDLEOCR_VL_GGUF_OFFICIAL_BASE_URL=https://
PADDLEOCR_VL_BASE_URL=https://
UNLIMITED_OCR_BASE_URL=https://
GLM_OCR_BASE_URL=https://
GLM_OCR_GGUF_Q4_BASE_URL=https://
GLM_OCR_GGUF_Q8_BASE_URL=https://
DOCLING_BASE_URL=https://
MINERU_BASE_URL=https://
MINERU_GGUF_Q8_BASE_URL=https://
MINERU_GGUF_Q4_BASE_URL=https://


# Optional
JPEG_QUALITY=92
JPEG_ABOVE_KB=400
PANE_MAX_HEIGHT=68vh
